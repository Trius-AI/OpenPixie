{application, openpixie,
 [{description, "LLM-driven autonomous AI assistant"},
  {vsn, "0.1.0"},
  {registered, []},
  {mod, {openpixie_app, []}},
  {applications,
   [kernel,
    stdlib,
    cowboy,
    hackney,
    jsx,
    crypto,
    lager
   ]},
  {env,
   [{ollama_host, "http://localhost:11434"},
    {ollama_model, <<"glm-5:cloud">>},
    {http_port, 8080},
    {idle_timeout_minutes, 30},
    {permission_mode, ask},
    {max_llm_concurrency, 1},
    {circuit_breaker_failures, 5},
    {circuit_breaker_cooldown_ms, 30000},
    {llm_timeout_ms, 120000},
    {max_context_tokens, 32768},
    {workspace, "."}
   ]},
   {modules,
    [openpixie_app,
     openpixie_sup,
     openpixie_config,
     openpixie_auth,
     openpixie_ollama,
     openpixie_circuit_breaker,
     openpixie_semaphore,
     openpixie_channel,
     openpixie_topic,
     openpixie_topic_sup,
     openpixie_topic_store,
     openpixie_skills,
     openpixie_memory,
     openpixie_metrics,
     openpixie_archive,
     openpixie_reflection,
     openpixie_cron,
     openpixie_tools,
     openpixie_tools_file,
     openpixie_tools_git,
     openpixie_tools_command,
     openpixie_tools_search,
     openpixie_tools_memory,
     openpixie_tools_skills,
     openpixie_tools_self,
     openpixie_tools_meta,
     openpixie_tools_schema,
     openpixie_permissions,
     openpixie_http,
     openpixie_http_chat,
     openpixie_http_topics,
     openpixie_http_health,
     openpixie_http_models,
     openpixie_http_skills,
     openpixie_ws,
     openpixie_setup,
     openpixie_soul,
     openpixie_context,
     openpixie_log,
     openpixie_kirino,
      openpixie_tools_ask,
      openpixie_sync,
      openpixie_http_sync,
      openpixie_tools_sync,
      openpixie_tool_registry,
      openpixie_http_config,
      openpixie_http_spa
    ]},
  {licenses, ["Apache-2.0"]},
  {links, []}
 ]}.