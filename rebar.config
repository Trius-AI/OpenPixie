{erl_opts, [debug_info]}.

{deps, [
    {cowboy, "2.13.0"},
    {hackney, "1.20.1"},
    {jsx, "3.1.0"},
    {yamerl, "0.8.1"},
    {lager, "3.9.2"}
]}.

{shell, [
    {apps, [openpixie]}
]}.

{profiles, [
    {prod, [
        {relx, [
            {include_src, false},
            {include_erts, false},
            {extended_start_script, true}
        ]}
    ]}
]}.

{relx, [
    {release, {openpixie, "0.1.0"}, [
        kernel,
        stdlib,
        sasl,
        lager,
        cowboy,
        ranch,
        cowlib,
        hackney,
        jsx,
        yamerl,
        openpixie
    ]},
    {sys_config, "config/sys.config"},
    {vm_args, "config/vm.args"}
]}.